{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.1.0",
  "identifier": "dev.twistedsignal.prism",
  "build": { "beforeDevCommand": "pnpm vite", "devUrl": "http://localhost:5274", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Prism", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600, "decorations": false }], "security": { "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'", "assetProtocol": { "enable": true, "scope": ["$APPDATA/projects/**"] } } },
  "bundle": { "active": true, "targets": "all", "category": "DeveloperTool", "shortDescription": "Render models locally with Blender.", "resources": ["../backend/prism_render.py"] }
}
