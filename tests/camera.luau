local fs = require('@lune/fs')
local luau = require('@lune/luau')
local code = fs.readFile('src/CameraControls.luau'):gsub('%f[%w]const%f[%W]', 'local')
local controls = luau.load(code)()
local original = { cameraRotation = 179, cameraElevation = 80, zoom = 1 }
local orbit = controls.orbit(original, 10, 40)
assert(orbit.cameraRotation == -176 and orbit.cameraElevation == 89)
assert(controls.orbit({ cameraRotation = 0 }, 20, 0).cameraRotation == 10)
assert(controls.orbit({ cameraRotation = 0 }, -20, 0).cameraRotation == -10)
assert(controls.orbit(original, 0, -400).cameraElevation == -89)
assert(original.cameraRotation == 179 and original.zoom == 1)
assert(controls.zoom(original, 1).zoom > original.zoom)
assert(math.abs(controls.zoom(controls.zoom(original, 1), -1).zoom - 1) < 1e-6)
assert(controls.zoom(original, 100).zoom == 5)
assert(controls.zoom(original, -100).zoom == 0.1)
print('Camera orbit and zoom checks passed')
